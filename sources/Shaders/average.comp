#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_atomic_float : enable


#include "common.glsl"


//maxComputeWorkGroupInvocations
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;




void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= VHM_BUFFER_SIZE)
        return;

    if (pc.CurrentVHM.keys.at[index] == VHM_EMPTY_KEY)
        return;

    VHData voxel = pc.CurrentVHM.values.at[index];    

#if 0
    if (voxel.frame == pc.FrameNo)
    {
        //float decay = 0.01;

        //float decay = max(pow(0.95, floor(voxel.radiance.w / 512.0)), 0.125);

        //float decay = max(pow(0.98, floor(voxel.radiance.w / 32768.0)), 0.5);
        //float decay = max(pow(0.95, floor(voxel.radiance.w / 16384.0)), 0.5);
        float decay = max(pow(0.95, floor(voxel.radiance.w / 4096.0)), 0.75);

        //float decay = mix(1.0, 0.9, float(voxel.radiance.w >= 4096));

        pc.CurrentVHM.values.at[index].radiance *= decay;
        pc.CurrentVHM.values.at[index].sun *= decay;
    }
#endif

    if (voxel.gen < pc.CurrentGen)
    {
        float decay = min(1024.0 / voxel.radiance.w, 1.0);
        //float decay = min(512.0 / voxel.radiance.w, 1.0);
        //float decay = 0.01;

        pc.CurrentVHM.values.at[index].radiance *= decay;
        pc.CurrentVHM.values.at[index].sun *= decay;
        pc.CurrentVHM.values.at[index].gen = pc.CurrentGen;
    }
}

