#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : enable
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_shader_atomic_float : enable


#include "common.glsl"


//maxComputeWorkGroupInvocations
layout(local_size_x = 1024, local_size_y = 1, local_size_z = 1) in;


void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= VHM_BUFFER_SIZE)
        return;

    if (pc.CurrentVHM.keys.at[index] == VHM_EMPTY_KEY)
        return;

    VHData voxel = pc.CurrentVHM.values.at[index];

    //uint purgeKey = mix(VHM_EMPTY_KEY, pc.CurrentVHM.keys.at[index], voxel.frame < pc.FrameNo);
    //if (atomicCompSwap(pc.CurrentVHM.keys.at[index], purgeKey, VHM_EMPTY_KEY) == purgeKey)

    //if (voxel.frame < pc.FrameNo)
    
    if (pc.FrameNo - voxel.frame > 2048)
    {
        // Purge voxels that haven't been seen for some while.
        atomicExchange(pc.CurrentVHM.keys.at[index], VHM_EMPTY_KEY);
        atomicExchange(pc.CurrentVHM.values.at[index].radiance.r, 0.0);
        atomicExchange(pc.CurrentVHM.values.at[index].radiance.g, 0.0);
        atomicExchange(pc.CurrentVHM.values.at[index].radiance.b, 0.0);
        atomicExchange(pc.CurrentVHM.values.at[index].radiance.w, 0.0);
        atomicExchange(pc.CurrentVHM.values.at[index].sun, 0.0);
        atomicExchange(pc.CurrentVHM.values.at[index].frame, 0);

        return;
    }
    

    //float reduce = mix(1.0, 0.95, float(voxel.radiance.w == VHM_SAMPLE_LIMIT));
    //pc.CurrentVHM.values.at[index].radiance *= reduce;
/*
    vec4 currentValue = voxel.radiance;
    float currentSun = voxel.sun;

    float div = max(floor(currentValue.w / 262100.0), 1.0);

    pc.CurrentVHM.values.at[index].radiance = currentValue / div;
    pc.CurrentVHM.values.at[index].sun = currentSun / div;*/
}