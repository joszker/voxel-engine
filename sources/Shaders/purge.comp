void main()
{
    uint index = gl_GlobalInvocationID.x;

    if (index >= VHM_BUFFER_SIZE)
        return;

    if (pc.CurrentVHM.keys.at[index] == VHM_EMPTY_KEY)
        return;

    uint key = pc.CurrentVHM.keys.at[index];
    VHData data = pc.CurrentVHM.values.at[index];

    if (pc.FrameNo - data.frame <= 2048)
    {
        // only keep relatively fresh entries
        VHM_Copy(pc.BackupVHM, key, data);
    }
}